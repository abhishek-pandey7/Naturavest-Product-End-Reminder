    {
      "parameters": {
        "jsCode": "// 1. Get base lifespan days from product metafields\nlet metafields = $json.metafields || [];\nlet baseLifespan = 30; // Default fallback\n\nfor (let i = 0; i < metafields.length; i++) {\n  if (metafields[i].namespace === 'custom' && metafields[i].key === 'lifespan_days') {\n    baseLifespan = parseInt(metafields[i].value);\n    break;\n  }\n}\n\n// 2. Get Quantity and Variant Name from Shopify Trigger\nlet triggerData = $('Shopify Trigger').item.json;\nlet quantity = triggerData.line_items[0].quantity || 1;\nlet variantName = triggerData.line_items[0].variant_title || '';\n\n// 3. Extract Pack Multiplier from Variant Name\nlet packMultiplier = 1;\nlet packMatch = variantName.match(/Pack of (\\d+)/i);\nif (packMatch) {\n  packMultiplier = parseInt(packMatch[1]);\n}\n\n// 4. Calculate Total Lifespan\nlet totalLifespan = baseLifespan * quantity * packMultiplier;\n\n// 5. Calculate Date 1 (Pre-runout: Total - 2 days)\nlet date1 = new Date();\ndate1.setDate(date1.getDate() + (totalLifespan - 2));\nlet reminder1 = date1.toISOString().split('T')[0];\n\n// 6. Calculate Date 2 (Post-runout: Total + 2 days)\nlet date2 = new Date();\ndate2.setDate(date2.getDate() + (totalLifespan + 2));\nlet reminder2 = date2.toISOString().split('T')[0];\n\n// 7. Output both dates and the order ID\nreturn {\n  json: {\n    order_id: triggerData.id,\n    reminder_date_1: reminder1,\n    reminder_date_2: reminder2\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-64, -8272],
