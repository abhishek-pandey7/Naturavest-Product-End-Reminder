    {
      "parameters": {
        "jsCode": "// 1. Get the metafields array from the HTTP Request node\nlet metafields = $json.metafields || [];\nlet lifespanDays = null;\n\n// 2. Search the array for our custom.lifespan_days key\nfor (let i = 0; i < metafields.length; i++) {\n  if (metafields[i].namespace === 'custom' && metafields[i].key === 'lifespan_days') {\n    lifespanDays = parseInt(metafields[i].value);\n    break;\n  }\n}\n\n// 3. If we didn't find it, default to 30 days so the workflow doesn't crash\nif (!lifespanDays) lifespanDays = 30;\n\n// 4. Calculate the days to wait (Lifespan minus 5 days warning)\nlet daysToWait = lifespanDays - 5;\n\n// 5. Get today's date and add the days to wait\nlet reminderDate = new Date();\nreminderDate.setDate(reminderDate.getDate() + daysToWait);\n\n// 6. Format the date to YYYY-MM-DD (which Shopify requires)\nlet formattedDate = reminderDate.toISOString().split('T')[0];\n\n// 7. Get the Order ID from the Shopify Trigger node so we know where to save this\nlet orderId = $('Shopify Trigger').item.json.id;\n\n// 8. Output the result\nreturn {\n  json: {\n    order_id: orderId,\n    reminder_date: formattedDate\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
