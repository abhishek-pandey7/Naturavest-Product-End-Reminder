      "parameters": {
        "jsCode": "// 1. Get the lifespan days from the incoming webhook\nlet lifespanDays = $json.body.lifespan_days || 30; \n\n// 2. Calculate how many days to wait (Lifespan minus 5 days warning)\nlet daysToWait = lifespanDays - 5;\n\n// 3. Get today's date\nlet reminderDate = new Date();\n\n// 4. Add the daysToWait to today's date\nreminderDate.setDate(reminderDate.getDate() + daysToWait);\n\n// 5. Format the date to YYYY-MM-DD (which Shopify requires)\nlet formattedDate = reminderDate.toISOString().split('T')[0];\n\n// 6. Output the result so the next node can use it\nreturn {\n  json: {\n    customer_name: $json.body.customer_name,\n    customer_phone: $json.body.customer_phone,\n    reminder_date: formattedDate\n  }\n};"
